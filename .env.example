# Django
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 数据库（默认 SQLite，可换成 MySQL/PostgreSQL）
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=mysql://root:root@127.0.0.1:3306/dbms
# DATABASE_URL=postgres://dbms:dbms@127.0.0.1:5432/dbms

# Broker / Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# 密码加密主密钥（必须 32 字节 base64，python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"）
FERNET_KEY=change-me-change-me-change-me-change-me-

# 密码轮换策略
PASSWORD_ROTATE_INTERVAL_HOURS=12
PASSWORD_MIN_LENGTH=24
PASSWORD_CHARSET=alphanumeric       # alphanumeric | ascii | hex
